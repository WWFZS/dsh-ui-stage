{
  "name": "dsh-ui-stage",
  "version": "2.1.3",
  "type": "module",
  "description": "开机动画 + 界面主题 + 桌面宠物，一个插件三件事：启动时全屏动画盖住加载页直到应用就绪再淡出；同一套素材还能当壁纸铺在界面后面（遮罩厚度 / 壁纸模糊 / 色彩浓度可调）；另有桌面宠物浮在屏幕上、可点可拖。内置视频、壁纸、语音与宠物素材库，也支持上传自己的文件。",
  "license": "MIT",
  "author": "dsh-ui-stage contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WWFZS/dsh-ui-stage.git"
  },
  "homepage": "https://github.com/WWFZS/dsh-ui-stage#readme",
  "bugs": {
    "url": "https://github.com/WWFZS/dsh-ui-stage/issues"
  },
  "gitee": {
    "url": "https://gitee.com/weiwenfengzs/dsh-plugin-startup-animation"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "startup",
    "boot",
    "splash",
    "animation",
    "theme"
  ],
  "engines": {
    "node": ">=22.12.0",
    "dsh": ">=0.2.0"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./icon.svg": "./icon.svg"
  },
  "files": [
    "package.json",
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/self-manage.mjs",
    "lib/wallpaper.mjs",
    "lib/wallpaper-colors.mjs",
    "lib/desktop-pet.mjs",
    "runtime/boot.css",
    "runtime/boot.js",
    "runtime/pet-desktop/main.cjs",
    "runtime/pet-desktop/preload.cjs",
    "runtime/pet-desktop/renderer.js",
    "runtime/pet-desktop/index.html",
    "builtin/MP4/*.web.mp4",
    "builtin/MP4/.posters/*",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs/*.jpg",
    "docs/*.png",
    "docs/*.gif",
    "LICENSE",
    "builtin/图片/**/*",
    "builtin/音频/**/*",
    "builtin/宠物/**/*"
  ],
  "scripts": {
    "test": "node selftest.mjs && node lib/wallpaper-test.mjs && node lib/desktop-pet-test.mjs && node tools/sync-wallpaper-inline.mjs --check && node tools/boot-runtime.mjs && node tools/client-test.mjs && node lib/self-manage-test.mjs && node lib/e2e-uninstall.mjs && node tools/host-smoke.mjs",
    "test:unit": "node selftest.mjs",
    "test:wallpaper": "node lib/wallpaper-test.mjs",
    "test:desktop": "node lib/desktop-pet-test.mjs",
    "test:boot": "node tools/boot-runtime.mjs",
    "test:client": "node tools/client-test.mjs",
    "test:self": "node lib/self-manage-test.mjs",
    "test:e2e": "node lib/e2e-uninstall.mjs",
    "test:desktop-e2e": "node tools/desktop-e2e.mjs",
    "test:css": "node tools/boot-css-test.mjs",
    "test:host": "node tools/host-smoke.mjs",
    "thumbs": "node tools/make-thumbs.mjs",
    "optimize": "node tools/optimize-builtin.mjs",
    "build": "node tools/optimize-builtin.mjs && node tools/make-thumbs.mjs",
    "check": "node tools/preflight.mjs",
    "release": "node tools/make-release.mjs"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
